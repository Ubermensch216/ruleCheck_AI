{
  "name": "grc-compliance-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run tests/evaluation",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "jsonrepair": "^3.13.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "marked": "^16.1.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/vite-plugin-svelte": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/pdfkit": "^0.17.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
